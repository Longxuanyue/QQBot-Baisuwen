# ============================================================
#  白苏文 (BaiSuWen) 配置文件模板
#  复制此文件为 .env 并填入你的实际配置
#  cp .env.example .env    (Linux/macOS)
#  copy .env.example .env  (Windows)
# ============================================================

# ──────────────────────────────────────────────
#  一、运行环境
# ──────────────────────────────────────────────

# 运行环境：dev（开发环境）| prod（生产环境）
# dev   = 启用 DEBUG 日志，加载 dev 专属配置
# prod  = 生产模式，ERROR 级别日志
ENVIRONMENT=dev

# NoneBot 驱动器组合：~fastapi（HTTP 服务）+ ~websockets（WebSocket）
# 同时提供 REST API 和反向 WS 连接能力，一般为固定值
DRIVER=~fastapi+~websockets

# NoneBot 服务监听地址
# 127.0.0.1 = 仅本机访问（安全，推荐）
# 0.0.0.0   = 允许局域网/公网访问（注意安全风险）
HOST=127.0.0.1

# NoneBot 服务监听端口
# 需与 OneBot 协议端的反向 WS 地址端口一致
PORT=42200

# 日志级别（从低到高: DEBUG | INFO | WARNING | ERROR）
# DEBUG = 输出所有调试信息，排查问题时使用
# INFO  = 常规运行日志（推荐）
LOG_LEVEL=INFO

# Uvicorn ASGI 服务器的日志级别
# 可选: critical | error | warning | info | debug | trace
UVICORN_LOG_LEVEL=info


# ──────────────────────────────────────────────
#  二、QQ 机器人身份
# ──────────────────────────────────────────────

# 超级用户 QQ 号列表（JSON 数组格式）
# 超管拥有最高权限：管理命令、WebUI 登录、强制操作等
SUPERUSERS=["<你的QQ号>"]

# 机器人昵称（用于群聊中判断是否被 @ 或呼唤）
# 用户消息中包含此昵称时，Bot 会触发回复
BOT_NICKNAME=<你的机器人昵称>

# NoneBot 内置 to_me 检测昵称列表（JSON 数组格式）
# 支持多昵称，Bot 对其中任一名字都会响应
NICKNAME=["<你的机器人昵称>"]

# 人设配置文件路径（相对于项目根目录）
# 包含角色的性格、说话风格、背景故事等定义
PERSONALITY_FILE=src/plugins/nonebot_plugin_update_baisuwen/personality_traits.json


# ──────────────────────────────────────────────
#  三、DeepSeek LLM（AI 对话大脑）
# ──────────────────────────────────────────────

# DeepSeek API 密钥（必填）
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=<你的DeepSeek_API_Key>

# DeepSeek API 基础 URL
# 可替换为任何 OpenAI 兼容的 API 端点
DEEPSEEK_API_BASE=https://api.deepseek.com

# 使用的模型名称
# DeepSeek 推荐: deepseek-chat (V3), deepseek-v4-pro
# 注意: vision 功能需要模型支持图片输入
DEEPSEEK_MODEL=deepseek-v4-pro

# HTTP 请求超时时间（秒）
# LLM 生成较长回复时可能耗时，建议 >= 60
HTTPX_TIMEOUT=60

# 单次请求上下文预算（token 估算值，非精确计数）
# 超出预算时按优先级裁剪：最旧对话历史 > 记忆/画像附加信息 > system prompt 尾部
# 默认 8192；可根据模型上下文窗口与成本偏好调整
LLM_MAX_CONTEXT_TOKENS=8192

# LLM 调用失败重试次数（429 / 5xx / 网络错误时指数退避重试）
LLM_MAX_RETRIES=2

# 重试退避基础间隔（秒），实际等待 = backoff * 2^(attempt-1)，上限 10s
LLM_RETRY_BACKOFF=1.0

# 流式回复（实验性，默认关闭）：边生成边发送，新消息替换上一条
# 开启后回复"打字机"效果，但会频繁发送/删除消息，群聊慎用
LLM_STREAM_REPLY=false

# 记忆提取最小间隔（秒）：同一用户两次 LLM 记忆提取的最短间隔
# 降低对话成本；群聊非@消息与过短消息不触发提取
MEMORY_EXTRACT_MIN_INTERVAL=300

# 记忆提取专用模型（可选）
# 留空则与主对话使用同一模型；可填便宜型号（如 deepseek-chat）降低成本
MEMORY_EXTRACT_MODEL=

# 向量语义检索（可选，需安装 sentence-transformers 并下载模型，约 100MB）
# 开启后：夜间任务为记忆计算向量，检索时与字面检索做 RRF 融合，
# 能命中「字面不同但语义相近」的记忆（如「今晚开黑吗」与「昨天约的打游戏」）
ENABLE_VECTOR_SEARCH=false

# 中文检索说明（无需配置）：
# - FTS5 trigram 双表：中文任意子串命中（「咖啡」可命中「用户喜欢喝咖啡」）
# - 空结果自动降级 LIKE → BM25
# - 领域词典 data/jieba_dict.txt + 群聊共现动态词典（user_data/dynamic_jieba_dict.txt）
# - 别名扩展 data/aliases.json + 群风格卡提炼的群级别名



# ──────────────────────────────────────────────
#  四、OneBot V11 协议（QQ 接入）
# ──────────────────────────────────────────────

# 反向 WebSocket 连接地址（NoneBot 作为服务端，协议端主动连接）
# 需在 QQ 协议端（NapCat/Lagrange/LLOneBot）中配置相同地址
ONEBOT_WS_REVERSE_URL=ws://127.0.0.1:42200/onebot/v11/ws


# ──────────────────────────────────────────────
#  五、群聊行为
# ──────────────────────────────────────────────

# 群聊中非 @/非昵称触发时的随机回复概率（0~1）
# 0    = 仅响应明确指令和 @/昵称呼唤（推荐，避免骚扰）
# 0.05 = 5% 概率搭话，更活跃
GROUP_REPLY_PROBABILITY=0

# 群聊回复冷却时间（秒）
# 同一群内两次回复的最小间隔
GROUP_REPLY_COOLDOWN=5.0


# ──────────────────────────────────────────────
#  六、对话管理
# ──────────────────────────────────────────────

# 会话中保留的最大对话轮数（user+assistant 各算 1 轮）
# 超过后将最早的消息移出上下文窗口
DIALOG_MAX_TURNS=20

# 会话超时时间（秒），超过此时间无新消息则自动清理会话
# 1800 = 30 分钟
DIALOG_SESSION_TTL=1800

# 会话轮数超过该值后，后台把最早的一半消息压缩成"对话纪要"（滚动摘要）
# 摘要会作为 system 消息注入，替代被压缩的原始消息，控制上下文体积
DIALOG_SUMMARY_THRESHOLD=16

# 两次滚动摘要之间的最小间隔（秒），避免频繁调用 LLM
DIALOG_SUMMARY_MIN_INTERVAL=600

# 相同消息回复缓存有效期（秒）
# 期间同一用户重复发送完全相同的消息直接复用上次回复，节省 API 调用
# 时间敏感消息（时间/日期类）不命中缓存；设为 0 关闭
REPLY_CACHE_TTL=600


# ──────────────────────────────────────────────
#  七、休眠与定时任务
# ──────────────────────────────────────────────

# 机器人休眠开始时间（格式 HH:MM）
# 休眠期间不响应任何消息（LLM 不消耗 Token）
BOT_SLEEP_START=23:30

# 机器人休眠结束时间（格式 HH:MM），支持跨天
BOT_SLEEP_END=06:00

# 记忆维护任务：执行时间（24小时制小时）
# 在此时间执行遗忘衰减、短期→长期升级、去重合并等
MEMORY_MAINTENANCE_HOUR=2

# 记忆维护任务：执行分钟
MEMORY_MAINTENANCE_MINUTE=0


# ──────────────────────────────────────────────
#  八、记忆系统
# ──────────────────────────────────────────────

# ── 基本配置 ──

# 每次检索返回的最相关记忆条数
MEMORY_TOP_K=5

# 上下文感知检索时保留的最近对话轮数
MEMORY_CONTEXT_HISTORY_LEN=2

# 默认重要性评分（0~1），新记忆的初始权重
MEMORY_DEFAULT_IMPORTANCE=0.6

# ── 存储路径 ──

# 短期记忆数据库路径（单用户模式），留空则使用项目根目录/short_term.db
MEMORY_SHORT_TERM_DB=

# 长期记忆数据库路径（单用户模式），留空则使用项目根目录/long_term.db
MEMORY_LONG_TERM_DB=

# 多用户模式：按用户 ID 分库存储的目录（相对于项目根目录）
# 目录结构: user_data/short_{uid}.db, user_data/long_{uid}.db
MEMORY_USER_DATA_DIR=user_data

# ── 容量限制 ──

# 短期记忆库最大容量（条数）
# 超出后触发最旧/最低权重记忆清理
MEMORY_SHORT_TERM_MAX=2000

# 长期记忆库最大容量（条数）
MEMORY_LONG_TERM_MAX=5000

# ── 遗忘算法（幂律衰减） ──

# 幂律衰减指数（beta），控制遗忘速度
# 0.3 = 遗忘较慢  0.5 = 中等  0.8 = 遗忘较快
MEMORY_BETA=0.5

# 复习增强学习率（eta），每次访问后的记忆强化程度
# 0.1 = 轻微增强  0.3 = 中等  0.5 = 大幅增强
MEMORY_ETA=0.3

# 记忆权重低于此阈值时被自动清理（0~1）
MEMORY_WEIGHT_THRESHOLD=0.1

# ── 记忆升级（短期 → 长期） ──

# 升级到长期库所需的重要性阈值（0~1）
MEMORY_UPGRADE_IMPORTANCE_THRESHOLD=0.7

# 升级到长期库所需的最小访问次数
MEMORY_UPGRADE_ACCESS_COUNT_THRESHOLD=5

# 升级到长期库所需的权重阈值
MEMORY_UPGRADE_WEIGHT_THRESHOLD=0.5

# ── 去重与合并 ──

# 去重相似度阈值（0~1），新记忆与已有记忆相似度高于此值时判断为重复
MEMORY_SIMILARITY_THRESHOLD=0.85

# 合并相似记忆的阈值（0~1），高于此值时将两条记忆合并为一条
MEMORY_MERGE_SIMILARITY_THRESHOLD=0.9


# ──────────────────────────────────────────────
#  九、ASR 语音识别（Whisper）
# ──────────────────────────────────────────────

# 是否启用语音识别
# true  = 用户发送语音消息时自动转文字
# false = 语音功能完全关闭
ENABLE_ASR=true

# Whisper 模型大小
# tiny  = ~39M，最快、精度最低，适合 CPU 轻量部署
# base  = ~74M
# small = ~244M，推荐（速度与精度的平衡点）
# medium= ~769M，精度高但需更多显存
# large = ~1.5G，最高精度，需大量显存
ASR_MODEL_SIZE=small

# ASR 运算设备
# cuda = NVIDIA GPU 推理（速度快 5~20 倍）
# cpu  = CPU 推理（速度较慢，但无需显卡）
ASR_DEVICE=cuda

# ASR 识别语言
# zh  = 中文，en = 英文，ja = 日文
# 留空或 auto = Whisper 自动检测
ASR_LANGUAGE=zh


# ──────────────────────────────────────────────
#  十、TTS 语音合成
# ──────────────────────────────────────────────

# 是否启用语音合成
# true  = 支持将文本回复转为语音发送
# false = 纯文字交流
ENABLE_TTS=true

# ── TTS 引擎选择 ──
# vits       = 原生 VITS 模型，Rosmontis 单音色，<1s 生成，零外部依赖
# gpt_sovits = GPT-SoVITS 模型，支持 24 角色策略3情感路由，3~5s 生成
#              需预先配置 GPT-SoVITS 模型和参考音频
TTS_ENGINE=vits

# ── VITS 引擎参数 ──

# VITS 模型文件路径（绝对路径或相对于项目根目录）
TTS_MODEL_PATH=models/G_latest.pth

# VITS 配置文件路径（JSON 格式，定义说话人）
TTS_CONFIG_PATH=models/finetune_speaker.json

# 是否总是以语音回复（即使用户发的不是语音）
# true  = 所有回复都用语音
# false = 仅当用户发语音时才回复语音
TTS_ALWAYS=false

# TTS 语速（>1 加快，<1 减慢）
TTS_SPEED=1.0

# TTS 语调随机性 / 情感幅度（0.3~0.8）
# 值越高语调越丰富多变
TTS_NOISE_SCALE=0.667

# TTS 时长随机性 / 节奏变化（0.3~1.0）
# 值越高句内停顿越自然（但可能不均衡）
TTS_NOISE_SCALE_W=0.8

# 长文本拆分时单句最大字符数
# 超出后按标点自动断句，避免合成质量下降
TTS_MAX_SENTENCE_LEN=50

# 句间静音时长（毫秒），影响合成后多句之间的停顿
TTS_SILENCE_MS=300

# TTS 运算设备：cuda:0（指定 GPU）| cpu
# 留空则自动检测
TTS_DEVICE=cuda:0

# ── GPT-SoVITS 引擎参数（仅 TTS_ENGINE=gpt_sovits 时生效） ──

# GPT-SoVITS 推理配置文件路径（绝对路径）
# 指向 GPT-SoVITS 项目下的 tts_infer.yaml
GPT_SOVITS_CONFIG=<你的GPT-SoVITS项目路径>/configs/tts_infer.yaml

# GPT-SoVITS 模型版本
# 可选: v1 | v2 | v3 | v4 | v2Pro | v2ProPlus
# 需与训练权重版本匹配
GPT_SOVITS_VERSION=v2

# 情感路由兜底角色
# 当 Level1 情感匹配和 Level2 关键词匹配均未命中时使用的默认角色
# 角色名需与 ref_audio/index.json 或 characters.json 中的一致
GPT_SOVITS_DEFAULT_CHARACTER=陈千语

# GPT-SoVITS 推理设备
GPT_SOVITS_DEVICE=cuda:0

# 是否启用 fp16 半精度推理
# true  = 显存占用减半，速度略快（推荐）
# false = 全精度，质量稍高但需更多显存
GPT_SOVITS_IS_HALF=true

# 自定义训练权重路径（相对于 GPT-SoVITS 根目录）
# 留空则使用 tts_infer.yaml 中的默认底模
GPT_SOVITS_GPT_WEIGHTS=
GPT_SOVITS_SOVITS_WEIGHTS=


# ──────────────────────────────────────────────
#  十一、多模态（图片理解）
# ──────────────────────────────────────────────

# 是否启用多模态图片处理
# true  = 用户发送图片时，通过 LLM Vision API 理解图片内容
# false = 仅记录收到图片，不做内容分析
# 注意: 需 LLM 模型（DEEPSEEK_MODEL）支持 vision 能力
ENABLE_MULTIMODAL=true


# ──────────────────────────────────────────────
#  十二、游戏新闻插件（GAMENEWS）
# ──────────────────────────────────────────────

# 是否启用游戏新闻插件
GAMENEWS_ENABLED=true

# 数据自动刷新时间：小时（24小时制）
GAMENEWS_CRON_HOUR=8

# 数据自动刷新时间：分钟
GAMENEWS_CRON_MINUTE=0

# 每日综合推送时间：小时
GAMENEWS_PUSH_HOUR=8

# 每日综合推送时间：分钟
GAMENEWS_PUSH_MINUTE=30

# 紧迫事件阈值（小时内即将结束的视为紧迫）
GAMENEWS_URGENCY_HOURS=48

# 每日推送目标群号（JSON 数组格式）
# 例: ["798807723", "123456789"]
GAMENEWS_TARGET_GROUPS=[]


# ──────────────────────────────────────────────
#  十三、明日方舟森空岛（Skland）
# ──────────────────────────────────────────────

# GitHub 代理 URL（用于加速资源下载），留空则不使用代理
skland__github_proxy_url=

# GitHub Token（用于访问私有仓库或提高 API 请求限额）
# 留空则使用匿名访问（限额较低）
skland__github_token=

# 是否在启动时检查资源文件更新
skland__check_res_update=true

# 背景图片来源: default（默认）| custom（自定义）
skland__background_source=default

# 终末地背景图片是否使用简化模式（减少渲染开销）
skland__endfield_background_simple=false

# 集成战略（肉鸽）战绩背景图片来源
# 可选: rogue（默认）| custom
skland__rogue_background_source=rogue

# 暗语消息过期时间（秒）
skland__argot_expire=300

# 明日方舟抽卡记录每张渲染图最多展示的卡池数
skland__gacha_render_max=30

# 终末地抽卡记录每张渲染图最多展示的卡池数
skland__ef_gacha_render_max=5


# ──────────────────────────────────────────────
#  十四、HTML 渲染（Playwright）
# ──────────────────────────────────────────────

# 浏览器类型: chromium | firefox | webkit
HTMLRENDER_BROWSER=chromium

# 浏览器可执行文件路径（绝对路径）
# Windows 可用 Edge 替代 Chromium 以减少下载量
HTMLRENDER_BROWSER_EXECUTABLE_PATH=
# ──────────────────────────────────────────────
#  十五、群聊学习（nonebot_plugin_groupmind）
# ──────────────────────────────────────────────

# 总开关（默认 false）。关闭时全部群不采集、不学习
GROUP_LEARNING=false

# 新群默认是否开启学习（建议保持 false，由群主用 /群学习 on 显式开启）
GROUP_LEARN_DEFAULT=false

# 群记忆批量提取时刻（每日多次，逗号分隔 时:分）
# 低频批量任务，成本远低于逐条提取
GROUP_MEMORY_EXTRACT_TIMES=12:30,20:30

# 群风格卡每日生成时刻（时:分）
GROUP_STYLE_CARD_TIME=21:00

# 或每累计多少条群消息触发一次风格卡（二者取先到）
GROUP_STYLE_CARD_INTERVAL=500

# 群风格卡/群记忆提取专用模型（可选，留空则用主对话模型）
GROUP_STYLE_MODEL=

# 注入 system prompt 的群上下文块预算（token 估算值）
GROUP_CONTEXT_MAX_TOKENS=200

# 注入的群记忆条数
GROUP_MEMORY_TOP_K=3

# 是否允许'氛围分'调节群回复概率（默认 false；需 GROUP_REPLY_PROBABILITY > 0 才生效）
GROUP_ADAPTIVE_PROBABILITY=false

# 群消息流水保留条数（超出清理最旧消息）
GROUP_HISTORY_KEEP=500

